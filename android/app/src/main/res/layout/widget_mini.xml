<?xml version="1.0" encoding="utf-8"?>
<!-- Same RemoteViews limits as the other sizes: no <View>, no <Space>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mini_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:text="余额"
            android:textColor="#8A93A8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/mini_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="¥0.00"
            android:textColor="#E6EAF2"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="● 已连接"
            android:textColor="#10B981"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mini_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:text="今日"
            android:textColor="#8A93A8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/mini_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="还没花钱"
            android:textColor="#8A93A8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="更新于 --:--"
            android:textColor="#5C6478"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
